# Python
.venv/
__pycache__/
*.pyc

# Run logs: PowerShell writes them UTF-16 and they are regenerated by every run.
# The *.status files (one line per script start/exit) are kept.
paper/code/logs/*.log

# LaTeX build by-products (tectonic keeps none; pdflatex does)
*.aux
*.bbl
*.blg
*.out
paper/paper*/main.log
